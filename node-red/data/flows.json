    {
        "id": "fn_usgs",
        "type": "function",
        "z": "tab1",
        "name": "Store quakes + build chart points",
        "func": "var data = msg.payload;\nvar quakes = [];\nif (data && data.features) {\n  quakes = data.features.map(function (f) {\n    return { time: f.properties.time, mag: f.properties.mag, place: f.properties.place };\n  });\n}\nflow.set('recentQuakes', quakes);\nmsg.payload = quakes;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 950,
        "y": 500,
        "wires": [
            [
                "split_quakes"
            ]
        ]
    },
    {
        "id": "split_quakes",
        "type": "split",
        "z": "tab1",
        "name": "",
        "splt": "\\n",
        "spltType": "str",
        "arraySplt": 1,
        "arraySpltType": "len",
        "stream": false,
        "addname": "",
        "x": 1160,
        "y": 500,
        "wires": [
            [
                "fn_quake_point"
            ]
        ]
    },
    {
        "id": "fn_quake_point",
        "type": "function",
        "z": "tab1",
        "name": "Extract magnitude",
        "func": "if (!msg.payload) return null;\nvar quake = msg.payload;\nmsg.topic = 'quakes';\nmsg.quakeTime = quake.time;\nmsg.payload = quake.mag;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 1160,
        "y": 560,
        "wires": [
            [
                "chart_quakes"
            ]
        ]
    },
