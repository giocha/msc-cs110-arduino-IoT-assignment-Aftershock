        "z": "tab1",
        "name": "Correlate (real location + time)",
        "func": "var entry = msg.incidentEntry;\nvar data = msg.payload;\nvar quakes = (data && data.features) ? data.features.map(function (f) {\n  return { time: f.properties.time, mag: f.properties.mag, place: f.properties.place };\n}) : [];\n\nvar now = Date.now();\nvar nearby = quakes.filter(function (q) {\n  return Math.abs(now - q.time) < 15 * 60 * 1000;\n});\n\nvar severity = 1;\nvar note = 'No seismic activity found within 100km in the last 15 minutes - likely a fall or crash.';\nif (nearby.length > 0) {\n  severity = 2;\n  var best = nearby[0];\n  note = 'M' + best.mag + ' quake near ' + best.place + ' recorded around this time - possibly related.';\n}\n\nvar incidents = flow.get('incidents') || [];\nif (incidents.length > 0) {\n  incidents[0].correlation = note;\n  incidents[0].severity = severity;\n  flow.set('incidents', incidents);\n}\n\nmsg.payload = note;\nmsg.severity = severity;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 1200,
        "y": 280,
        "wires": [
            [
                "chg_alert_url",
                "log_correlation"
            ]
        ]
