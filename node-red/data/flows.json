    {
        "id": "chg_reference_location",
        "type": "function",
        "z": "tab1",
        "name": "Use real phone location, if known",
        "func": "var loc = flow.get('lastKnownLocation');\nif (!loc) {\n  return [null, { payload: 'Waiting for a phone location before checking nearby earthquakes.' }];\n}\nmsg.url = 'https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&latitude=' + loc.latitude + '&longitude=' + loc.longitude + '&maxradiuskm=300&limit=20&orderby=time';\nreturn [msg, null];",
        "outputs": 2,
        "noerr": 0,
        "x": 450,
        "y": 500,
        "wires": [
            [
                "req_usgs"
            ],
            [
                "log_quake_feed_status"
            ]
        ]
    },
    {
        "id": "req_usgs",
        "type": "http request",
        "z": "tab1",
        "name": "GET USGS earthquakes",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
