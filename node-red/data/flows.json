    {
        "id": "fn_felt",
        "type": "function",
        "z": "tab1",
        "name": "Log incident",
        "func": "var body = msg.payload || {};\nif (typeof body.latitude === 'number' && typeof body.longitude === 'number') {\n  flow.set('lastKnownLocation', { latitude: body.latitude, longitude: body.longitude, accuracy: body.accuracy });\n}\nvar incidents = flow.get('incidents') || [];\nvar entry = {\n  time: new Date().toISOString(),\n  source: body.source || 'phone',\n  latitude: body.latitude,\n  longitude: body.longitude,\n  accuracy: body.accuracy,\n  peakG: body.peakG\n};\nincidents.unshift(entry);\nincidents = incidents.slice(0, 20);\nflow.set('incidents', incidents);\n\nvar logLine = entry.time + ' - ' + entry.source + (entry.peakG ? (' - ' + entry.peakG + 'g') : '');\nvar respMsg = Object.assign({}, msg, { payload: 'OK', statusCode: 200 });\n\nvar locationLine = (typeof entry.latitude === 'number' && typeof entry.longitude === 'number')\n  ? entry.latitude.toFixed(4) + ', ' + entry.longitude.toFixed(4) + (typeof entry.accuracy === 'number' ? (' (±' + entry.accuracy.toFixed(0) + 'm)') : '')\n  : 'No location reported';\n\nreturn [\n  respMsg,\n  { payload: logLine },\n  { payload: entry },\n  { payload: locationLine }\n];",
        "outputs": 4,
        "noerr": 0,
        "x": 430,
        "y": 260,
        "wires": [
            [
                "resp_felt"
            ],
            [
                "log_incidents"
            ],
            [
                "fn_check_location"
            ],
            [
                "log_phone_location"
            ]
        ]
